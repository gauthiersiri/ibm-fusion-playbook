---
# roles/fusion_data_foundation/templates/provider_lb_service.j2
#
# LoadBalancer Service that exposes the OCS provider gRPC API (port 50051)
# to remote consumer clusters.
#
# Required after StorageCluster reaches Ready phase when fdf_deployment_mode == "provider".
#
# ref: IBM Fusion Software 2.14, Configuring FDF in provider mode, step 10d:
#   "Define a load balancer service YAML"

apiVersion: v1
kind: Service
metadata:
  name: "{{ fdf_provider_lb_service_name }}"
  namespace: "{{ fdf_namespace }}"
  annotations:
    metallb.universe.tf/ip-allocated-from-pool: "{{ fdf_provider_metallb_pool }}"
spec:
  type: LoadBalancer
  ports:
    - name: provider
      protocol: TCP
      port: 50051
      targetPort: ocs-provider
      nodePort: 30756
  selector:
    app: ocsProviderApiServer
