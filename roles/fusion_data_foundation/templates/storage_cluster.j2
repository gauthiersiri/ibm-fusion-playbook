apiVersion: ocs.openshift.io/v1
kind: StorageCluster
metadata:
  name: "{{ fdf_storage_cluster_name }}"
  namespace: "{{ fdf_namespace }}"
  annotations:
    cluster.ocs.openshift.io/local-devices: "true"
spec:
  monDataDirHostPath: /var/lib/rook
  resourceProfile: "{{ fdf_resource_profile }}"
  arbiter: {}
  externalStorage: {}
  encryption:
    kms: {}
  managedResources:
    cephObjectStores:
      # RGW hostNetwork kept false regardless of top-level hostNetwork setting.
      # Observed on FDF 4.20 provider CR and FDF 4.21 hostNetwork CR.
      hostNetwork: false
{% if fdf_deployment_mode == 'provider' %}
  # -----------------------------------------------------------------------
  # Provider mode only
  # ref: IBM Fusion Software 2.14 — Configuring FDF in provider mode
  # doc step 7: "Select Host as the Network option."
  # -----------------------------------------------------------------------
  hostNetwork: true
{% endif %}
  storageDeviceSets:
    - name: "{{ fdf_device_set_name }}"
      # count:1 + replica:3 = 3 OSDs — matches reference ITZ CR.
      # replica:3 satisfies osd_pool_default_size:3 for pool creation.
      count: 1
      replica: 3
      portable: false
      dataPVCTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          volumeMode: Block
          storageClassName: "{{ fdf_storage_class }}"
          resources:
            requests:
              # Use "1" — FDF selects PVs by storageClass, not by size.
              storage: "1"
