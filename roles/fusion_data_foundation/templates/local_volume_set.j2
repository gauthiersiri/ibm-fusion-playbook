apiVersion: local.storage.openshift.io/v1alpha1
kind: LocalVolumeSet
metadata:
  name: "{{ odf_lvs_name }}"
  namespace: "{{ lso_namespace }}"
spec:
  nodeSelector:
    nodeSelectorTerms:
      - matchExpressions:
          - key: "{{ odf_node_label_key }}"
            operator: Exists
  storageClassName: "{{ odf_storage_class }}"
  volumeMode: Block
  deviceInclusionSpec:
    deviceTypes:
      - disk
    deviceMechanicalProperties:
      - NonRotational
{% if odf_disk_min_size | length > 0 %}
    minSize: "{{ odf_disk_min_size }}"
{% endif %}
{% if odf_disk_max_size | length > 0 %}
    maxSize: "{{ odf_disk_max_size }}"
{% endif %}
