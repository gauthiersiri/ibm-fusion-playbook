apiVersion: local.storage.openshift.io/v1alpha1
kind: LocalVolumeSet
metadata:
  name: "{{ fdf_lvs_name }}"
  namespace: "{{ lso_namespace }}"
spec:
  nodeSelector:
    nodeSelectorTerms:
      - matchExpressions:
          - key: "{{ fdf_node_label_key }}"
            operator: Exists
  storageClassName: "{{ fdf_storage_class }}"
  volumeMode: Block
  deviceInclusionSpec:
    deviceTypes:
      - disk
    deviceMechanicalProperties:
      - NonRotational
{% if fdf_disk_min_size | length > 0 %}
    minSize: "{{ fdf_disk_min_size }}"
{% endif %}
{% if fdf_disk_max_size | length > 0 %}
    maxSize: "{{ fdf_disk_max_size }}"
{% endif %}
