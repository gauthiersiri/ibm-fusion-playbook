apiVersion: operators.coreos.com/v1alpha1
kind: CatalogSource
metadata:
  name: "{{ ibm_operator_catalog_name }}"
  namespace: "{{ ibm_operator_catalog_namespace }}"
spec:
  displayName: IBM Operator Catalog
  publisher: IBM
  sourceType: grpc
  image: "{{ ibm_operator_catalog_image }}"
  updateStrategy:
    registryPoll:
      interval: 45m
