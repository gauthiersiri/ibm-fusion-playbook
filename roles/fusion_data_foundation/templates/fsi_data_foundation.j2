apiVersion: service.isf.ibm.com/v1
kind: FusionServiceInstance
metadata:
  name: "{{ fdf_fsi_name }}"
  namespace: "{{ fusion_namespace }}"
spec:
  creator: User
  doInstall: true
  serviceDefinition: data-foundation-service
  triggerUpdate: false
  parameters:
    - name: namespace
      provided: false
      value: "{{ fdf_namespace }}"
    - name: creator
      provided: false
      value: Fusion
    - name: backingStorageType
      provided: true
      value: Local
    - name: autoUpgrade
      provided: false
      value: "true"
    - name: enableLVMStorage
      provided: true
      value: "false"
